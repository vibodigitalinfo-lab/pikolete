# Stripe Payment Link del informe premium ($9.99)
# En Stripe > Payment Links > "Después del pago" > redirigir a:
#   https://pikolete.com/api/unlock/verify?session_id={CHECKOUT_SESSION_ID}
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/test_xxxxxxxx

# Clave secreta de Stripe (solo servidor) para verificar el pago
STRIPE_SECRET_KEY=sk_test_xxxxxxxx

# Secreto para firmar la cookie de desbloqueo (cadena larga y aleatoria)
PIKOLETE_UNLOCK_SECRET=cambia-esto-por-una-cadena-larga-aleatoria

# Email que recibe las solicitudes de presupuesto
NEXT_PUBLIC_QUOTE_EMAIL=hola@pikolete.com

# true = permite el botón "desbloquear (demo)" sin pagar. Nunca en producción real.
PIKOLETE_DEMO_UNLOCK=false
