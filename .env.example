# Almacén privado de Vercel Blob donde se guardan los leads (Vercel lo crea solo al conectar el store).
# Sin él, en local los leads se guardan en data/leads.json
BLOB_READ_WRITE_TOKEN=

# Secreto para firmar la cookie que recuerda el informe desbloqueado (cadena larga y aleatoria)
PIKOLETE_UNLOCK_SECRET=cambia-esto-por-una-cadena-larga-aleatoria

# Contraseña para descargar los leads: https://pikolete.com/api/admin/leads
ADMIN_PASSWORD=

# Email de contacto mostrado en la web
NEXT_PUBLIC_QUOTE_EMAIL=hola@pikolete.com

# Datos del responsable para la política de privacidad (RGPD / LSSI)
NEXT_PUBLIC_LEGAL_OWNER=
NEXT_PUBLIC_LEGAL_TAX_ID=
NEXT_PUBLIC_LEGAL_ADDRESS=

# Envío del informe por email y avisos internos.
# Opción gratuita (recomendada): Resend, 3.000 emails/mes. API key en resend.com/api-keys
RESEND_API_KEY=

# Alternativa de pago: Cloudflare Email Sending (plan Workers Paid)
# CLOUDFLARE_ACCOUNT_ID: el ID de cuenta que aparece en la URL del panel de Cloudflare
# CLOUDFLARE_EMAIL_TOKEN: API token con permiso "Email Sending: Edit"
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_TOKEN=
# Remitente (dominio dado de alta en Email Sending)
EMAIL_FROM=Pikolete Inspector <hola@pikolete.com>
# Dónde recibir el aviso de cada solicitud de presupuesto
NOTIFY_EMAIL=

# Google AdSense. El ID de editor ya viene por defecto; los bloques son opcionales
# (sin ellos solo se ven los anuncios automáticos que actives en AdSense).
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-9478834967463774
NEXT_PUBLIC_ADSENSE_SLOT_LANDING=
NEXT_PUBLIC_ADSENSE_SLOT_RESULTS=
